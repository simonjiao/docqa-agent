# Copy this file to .env and fill in real values.
# .env is ignored by git and must not be committed.

# Required for QA. The application does not provide an extractive fallback.
DOCQA_LLM_BASE_URL=http://127.0.0.1:8080/v1
DOCQA_LLM_API_KEY=replace-with-your-api-key
DOCQA_LLM_MODEL=replace-with-your-model

# OCR/runtime defaults.
OCR_LANG=chi_sim+eng
OCR_DPI=120
OCR_TIMEOUT=30
STORAGE_DIR=./storage
PORT=8000
